# Environment Configuration for Data Quality Pipeline
# Copy to .env and customize for your environment
# Data locations
DATA_DIR=data
SWEETVIZ_OUTPUT=sweetviz_extracted
STORAGE_BASE_PATH=/opt/airflow/storage

# ==================== OLLAMA CONFIGURATION ====================
# Local LLM provider URL (accessible from Docker)
OLLAMA_URL=http://host.docker.internal:11434

# Any model pulled in Ollama (`ollama pull qwen2.5:14b-instruct`). Default used when unset: qwen2.5:14b-instruct
OLLAMA_MODEL=qwen2.5:14b-instruct

# Output budget, context window and read timeout of the table analysis. The structured answer is long:
# a small budget truncates the JSON and the whole answer is rejected. Slow local models may need a longer timeout.
TABLE_LLM_NUM_PREDICT=4096
GLOBAL_LLM_NUM_PREDICT=4096
LLM_NUM_CTX=16384
TABLE_LLM_TIMEOUT_SECONDS=300
# Reasoning ("thinking") models spend the budget thinking and can answer nothing; keep this off.
LLM_THINK=false

# One compact global LLM call after all table results are available.
GLOBAL_LLM_ENABLED=true
GLOBAL_LLM_TEMPERATURE=0.2
GLOBAL_LLM_TOP_P=0.9
GLOBAL_LLM_NUM_PREDICT=1800
GLOBAL_LLM_TIMEOUT_SECONDS=420

# ==================== AIRFLOW CONFIGURATION ====================
# Secret key for Airflow (change this in production!)
AIRFLOW_SECRET_KEY=change-this-airflow-secret-key
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-this-admin-password
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Airflow metadata database
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=airflow

# Backend callback security. Use the same value in Spring Boot.
PIPELINE_API_TOKEN=change-this-pipeline-token
BACKEND_URL=http://host.docker.internal:8081

# ==================== DOCKER COMPOSE ====================
# Compose project name (helps with container naming)
COMPOSE_PROJECT_NAME=data-quality-pipeline

# Runtime
ENV=development
LOG_LEVEL=INFO
