# Environment Configuration for Data Quality Pipeline
# Copy to .env and customize for your environment
# Data locations
DATA_DIR=data
SWEETVIZ_OUTPUT=sweetviz_extracted
STORAGE_BASE_PATH=/opt/airflow/storage

# ==================== OLLAMA CONFIGURATION ====================
# Local LLM provider URL (accessible from Docker)
OLLAMA_URL=http://host.docker.internal:11434

# Available models: qwen2.5, qwen3.5:35b, etc.
OLLAMA_MODEL=gemma4:cloud

# One compact global LLM call after all table results are available.
GLOBAL_LLM_ENABLED=true
GLOBAL_LLM_TEMPERATURE=0.2
GLOBAL_LLM_TOP_P=0.9
GLOBAL_LLM_NUM_PREDICT=1800
GLOBAL_LLM_TIMEOUT_SECONDS=420

# ==================== AIRFLOW CONFIGURATION ====================
# Secret key for Airflow (change this in production!)
AIRFLOW_SECRET_KEY=change-this-airflow-secret-key
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-this-admin-password
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Airflow metadata database
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=airflow

# Backend callback security. Use the same value in Spring Boot.
PIPELINE_API_TOKEN=change-this-pipeline-token
BACKEND_URL=http://host.docker.internal:8081

# ==================== DOCKER COMPOSE ====================
# Compose project name (helps with container naming)
COMPOSE_PROJECT_NAME=data-quality-pipeline

# Runtime
ENV=development
LOG_LEVEL=INFO
